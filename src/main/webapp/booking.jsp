<%@ page contentType="text/html;charset=UTF-8" %><% if(session.getAttribute("user")==null){response.sendRedirect("login.jsp");return;} %>
<!DOCTYPE html><html><head><title>Complete Booking</title><meta name="viewport" content="width=device-width,initial-scale=1"><link rel="stylesheet" href="css/style.css"><link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"></head><body><nav class="navbar navbar-dark nav-solid"><div class="container"><a class="navbar-brand fw-bold" href="index.jsp">✦ Incredible India Hotels</a></div></nav><main class="section"><div class="container"><span class="eyebrow dark">SECURE BOOKING</span><h1>Complete your reservation</h1><div class="row g-5 mt-2"><div class="col-lg-8"><form action="book" method="post" class="form-card"><input type="hidden" name="hotelId" value="<%=request.getParameter("hotelId")%>"><input type="hidden" name="roomId" value="<%=request.getParameter("roomId")%>"><input type="hidden" name="price" value="<%=request.getParameter("price")%>"><h3>Guest details</h3><div class="row g-3"><div class="col-md-6"><label>Guest Name</label><input required name="guestName" class="form-control"></div><div class="col-md-6"><label>Email</label><input required type="email" name="guestEmail" class="form-control"></div><div class="col-md-6"><label>Phone</label><input required name="guestPhone" class="form-control"></div><div class="col-md-6"><label>Adults</label><input required type="number" min="1" name="adults" value="2" class="form-control"></div><div class="col-md-6"><label>Children</label><input type="number" min="0" name="children" value="0" class="form-control"></div><div class="col-md-6"><label>Rooms</label><input required type="number" min="1" name="rooms" value="1" class="form-control"></div><div class="col-md-6"><label>Check-in</label><input required type="date" id="in" name="checkIn" class="form-control"></div><div class="col-md-6"><label>Check-out</label><input required type="date" id="out" name="checkOut" class="form-control"></div></div><button class="btn btn-brand btn-lg mt-4 w-100">Confirm Booking</button></form></div><div class="col-lg-4"><div class="booking-sticky"><span class="eyebrow dark">YOUR STAY</span><h3><%=request.getParameter("hotelName")%></h3><p><%=request.getParameter("roomName")%></p><hr><div class="d-flex justify-content-between"><span>Room rate</span><strong>₹<%=request.getParameter("price")%></strong></div><small>Taxes and service fee are calculated at confirmation.</small></div></div></div></div></main></body></html>
