<%@ page import="java.util.*,com.hotelbooking.model.Hotel" %><%@ page contentType="text/html;charset=UTF-8" %>
<!DOCTYPE html><html><head><title>Hotels | Incredible India</title><meta name="viewport" content="width=device-width,initial-scale=1"><link rel="stylesheet" href="css/style.css"><link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"></head><body>
<nav class="navbar navbar-expand-lg navbar-dark nav-solid"><div class="container"><a class="navbar-brand fw-bold" href="index.jsp">✦ Incredible India Hotels</a><a class="btn btn-light" href="index.jsp">Home</a></div></nav>
<main class="section"><div class="container"><div class="mb-4"><span class="eyebrow dark">STAY YOUR WAY</span><h1>Find your perfect stay</h1></div><form class="filterbar" action="hotels"><input class="form-control" name="destination" value="<%=request.getParameter("destination")==null?"":request.getParameter("destination")%>" placeholder="City or hotel name"><select class="form-select" name="category"><option>All hotel types</option><option>Luxury</option><option>Resort</option><option>Business</option><option>Budget</option></select><button class="btn btn-brand">Search</button></form><div class="row g-4 mt-2"><% List<Hotel> hs=(List<Hotel>)request.getAttribute("hotels"); for(Hotel h:hs){ %><div class="col-md-6 col-lg-4"><div class="hotel-card"><div class="hotel-img"><img src="<%=h.getImageUrl()%>" onerror="this.src='assets/images/hotels/fallback.svg'"></div><div class="hotel-body"><span class="stars"><%= "★".repeat((int)Math.round(h.getStarRating())) %></span><h3><%=h.getName()%></h3><p class="muted"><%=h.getCity()%>, <%=h.getState()%></p><p><%=h.getAmenities()%></p><div class="d-flex justify-content-between align-items-center"><strong class="price">₹<%=h.getStartingPrice()%></strong><a class="btn btn-brand" href="hotel?id=<%=h.getId()%>">View Details</a></div></div></div></div><% } %></div></div></main></body></html>
