<%@ page import="com.hotelbooking.model.Booking" %><%@ page contentType="text/html;charset=UTF-8" %><% Booking b=(Booking)request.getAttribute("booking"); %><!DOCTYPE html><html><head><title>Booking Confirmed</title><meta name="viewport" content="width=device-width,initial-scale=1"><link rel="stylesheet" href="css/style.css"><link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"></head><body><main class="confirmation"><div class="confirmation-card"><div class="success-icon">✓</div><span class="eyebrow dark">RESERVATION CONFIRMED</span><h1>Your stay is booked!</h1><p>Thank you for booking with Incredible India Hotels.</p><div class="summary"><div><span>Booking ID</span><strong><%=b.getBookingId()%></strong></div><div><span>Guest</span><strong><%=b.getGuestName()%></strong></div><div><span>Check-in</span><strong><%=b.getCheckIn()%></strong></div><div><span>Check-out</span><strong><%=b.getCheckOut()%></strong></div><div><span>Guests</span><strong><%=b.getAdults()%> Adults</strong></div><div><span>Total</span><strong>₹<%=b.getTotalAmount()%></strong></div></div><a class="btn btn-brand" href="my-bookings">View My Bookings</a><a class="btn btn-outline-dark ms-2" href="index.jsp">Back to Home</a></div></main></body></html>
