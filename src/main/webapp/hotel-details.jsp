<%@ page import="com.hotelbooking.model.*,java.util.*" %><%@ page contentType="text/html;charset=UTF-8" %><% Hotel h=(Hotel)request.getAttribute("hotel"); List<HotelImage> imgs=(List<HotelImage>)request.getAttribute("images"); List<Room> rooms=(List<Room>)request.getAttribute("rooms"); %>
<!DOCTYPE html><html><head><title><%=h.getName()%></title><meta name="viewport" content="width=device-width,initial-scale=1"><link rel="stylesheet" href="css/style.css"><link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"><link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.6.0/css/all.min.css" rel="stylesheet"></head><body><nav class="navbar navbar-dark nav-solid"><div class="container"><a class="navbar-brand fw-bold" href="index.jsp">✦ Incredible India Hotels</a><a href="hotels?destination=" class="btn btn-outline-light">All Hotels</a></div></nav>
<main class="section"><div class="container"><div class="d-flex justify-content-between flex-wrap gap-3 align-items-end mb-4"><div><span class="stars"><%= "★".repeat((int)Math.round(h.getStarRating())) %></span><h1><%=h.getName()%></h1><p class="muted"><i class="fa-solid fa-location-dot"></i> <%=h.getAddress()%>, <%=h.getCity()%>, <%=h.getState()%></p></div><div class="rating"><b><%=h.getGuestRating()%></b> Excellent · <%=h.getReviewCount()%> reviews</div></div>
<div class="gallery"><div class="gallery-main"><img id="mainImage" src="<%=imgs.get(0).getImageUrl()%>" onerror="this.src='assets/images/hotels/fallback.svg'"><button onclick="prevImage()" class="gallery-btn left">‹</button><button onclick="nextImage()" class="gallery-btn right">›</button><span id="counter" class="counter">1 / <%=imgs.size()%></span></div><div class="thumbs"><%for(int i=0;i<imgs.size();i++){%><img onclick="showImage(<%=i%>)" src="<%=imgs.get(i).getImageUrl()%>" onerror="this.src='assets/images/hotels/fallback.svg'"><%}%></div></div>
<div class="row mt-5 g-5"><div class="col-lg-8"><h2>About this hotel</h2><p class="lead"><%=h.getDescription()%></p><h3 class="mt-5">Amenities</h3><div class="amenities"><%for(String a:h.getAmenities().split(",")){%><div><i class="fa-solid fa-check"></i><%=a.trim()%></div><%}%></div><h3 class="mt-5">Choose your room</h3><%for(Room r:rooms){%><div class="room-card"><div><h4><%=r.getRoomName()%></h4><p><%=r.getDescription()%></p><span><i class="fa-solid fa-bed"></i> <%=r.getBedType()%> · <%=r.getMaxGuests()%> guests</span></div><div class="text-end"><h3>₹<%=r.getPricePerNight()%></h3><small>/ night</small><a href="booking.jsp?hotelId=<%=h.getId()%>&roomId=<%=r.getId()%>&hotelName=<%=java.net.URLEncoder.encode(h.getName(),"UTF-8")%>&roomName=<%=java.net.URLEncoder.encode(r.getRoomName(),"UTF-8")%>&price=<%=r.getPricePerNight()%>" class="btn btn-brand mt-2">Select Room</a></div></div><%}%></div><div class="col-lg-4"><div class="booking-sticky"><span class="eyebrow dark">STARTING FROM</span><h2>₹<%=h.getStartingPrice()%></h2><p>per night</p><a class="btn btn-brand w-100" href="#rooms">Choose a room</a></div></div></div></div></main>
<script>const images=[<%for(int i=0;i<imgs.size();i++){if(i>0)out.print(",");out.print("'"+imgs.get(i).getImageUrl().replace("'","\\'")+"'");}%>];let current=0;function showImage(i){current=i;document.getElementById('mainImage').src=images[i];document.getElementById('counter').textContent=(i+1)+' / '+images.length}function nextImage(){showImage((current+1)%images.length)}function prevImage(){showImage((current-1+images.length)%images.length)}</script></body></html>
