<%@ page import="java.util.*,com.hotelbooking.model.*" %><%@ page contentType="text/html;charset=UTF-8" %><!DOCTYPE html><html><head><title>My Bookings</title><meta name="viewport" content="width=device-width,initial-scale=1"><link rel="stylesheet" href="css/style.css"><link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"></head><body><nav class="navbar navbar-dark nav-solid"><div class="container"><a class="navbar-brand fw-bold" href="index.jsp">✦ Incredible India Hotels</a><a href="logout" class="btn btn-outline-light">Logout</a></div></nav><main class="section"><div class="container"><span class="eyebrow dark">YOUR JOURNEYS</span><h1>My Bookings</h1><div class="row g-4 mt-2"><%List<Booking> bs=(List<Booking>)request.getAttribute("bookings");for(Booking b:bs){%><div class="col-lg-6"><div class="booking-item"><div class="d-flex justify-content-between"><span class="badge text-bg-success"><%=b.getStatus()%></span><strong><%=b.getBookingId()%></strong></div><h3><%=b.getHotelName()%></h3><p><%=b.getRoomName()%> · <%=b.getCheckIn()%> → <%=b.getCheckOut()%></p><h4>₹<%=b.getTotalAmount()%></h4><%if("CONFIRMED".equals(b.getStatus())){%><form action="cancel-booking" method="post"><input type="hidden" name="bookingId" value="<%=b.getBookingId()%>"><button class="btn btn-outline-danger">Cancel Booking</button></form><%}%></div></div><%}%></div></div></main></body></html>
