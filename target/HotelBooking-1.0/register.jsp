<%@ page contentType="text/html;charset=UTF-8" %><!DOCTYPE html><html><head><title>Register</title><meta name="viewport" content="width=device-width,initial-scale=1"><link rel="stylesheet" href="css/style.css"><link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"></head><body><main class="auth-page"><div class="auth-card"><a href="index.jsp" class="brand-link">✦ Incredible India Hotels</a><h1>Create account</h1><p>Join us for beautiful stays across India.</p><%if(request.getAttribute("error")!=null){%><div class="alert alert-danger"><%=request.getAttribute("error")%></div><%}%><form action="register" method="post"><label>Full Name</label><input required name="fullName" class="form-control mb-3"><label>Email</label><input required type="email" name="email" class="form-control mb-3"><label>Phone</label><input required name="phone" class="form-control mb-3"><label>Password</label><input required minlength="8" type="password" name="password" class="form-control mb-4"><button class="btn btn-brand w-100">Create Account</button></form><p class="mt-4">Already registered? <a href="login.jsp">Sign in</a></p></div></main></body></html>
