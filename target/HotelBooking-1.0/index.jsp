<%@ page import="com.hotelbooking.dao.HotelDAO,java.util.*" %>
<%@ page contentType="text/html;charset=UTF-8" %>
<% request.setAttribute("featuredHotels", new HotelDAO().findAll("")); %>
<!DOCTYPE html><html><head><title>Incredible India Hotels</title><meta name="viewport" content="width=device-width,initial-scale=1"><link rel="stylesheet" href="css/style.css"><link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"><link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.6.0/css/all.min.css" rel="stylesheet"></head>
<body>
<nav class="navbar navbar-expand-lg navbar-dark fixed-top glass-nav"><div class="container"><a class="navbar-brand fw-bold" href="index.jsp"><i class="fa-solid fa-hotel"></i> Incredible India Hotels</a><button class="navbar-toggler" data-bs-toggle="collapse" data-bs-target="#nav"><span class="navbar-toggler-icon"></span></button><div class="collapse navbar-collapse" id="nav"><ul class="navbar-nav ms-auto"><li><a class="nav-link" href="index.jsp">Home</a></li><li><a class="nav-link" href="hotels?destination=">Hotels</a></li><li><a class="nav-link" href="#destinations">Destinations</a></li><li><a class="nav-link" href="about.jsp">About</a></li><li><a class="nav-link" href="contact.jsp">Contact</a></li><% if(session.getAttribute("user")==null){ %><li><a class="btn btn-light ms-lg-3" href="login.jsp">Login</a></li><%}else{%><li><a class="nav-link" href="my-bookings">My Bookings</a></li><li><a class="nav-link" href="logout">Logout</a></li><%}%></ul></div></div></nav>
<header class="hero"><div class="hero-overlay"></div><div class="container hero-content"><span class="eyebrow">LUXURY • COMFORT • INDIA</span><h1>Discover Incredible<br><span>Hotels Across India</span></h1><p>Book beautiful stays, luxury resorts and comfortable hotels at the best prices.</p>
<form action="hotels" method="get" class="search-box row g-2"><div class="col-lg-4"><input name="destination" class="form-control form-control-lg" placeholder="Where are you going?"></div><div class="col-lg-2"><input name="checkIn" type="date" class="form-control form-control-lg"></div><div class="col-lg-2"><input name="checkOut" type="date" class="form-control form-control-lg"></div><div class="col-lg-2"><select name="guests" class="form-select form-select-lg"><option>2 Adults</option><option>1 Adult</option><option>3 Adults</option><option>4 Adults</option></select></div><div class="col-lg-2"><button class="btn btn-brand btn-lg w-100">Search Hotels</button></div></form></div></header>
<section class="section" id="destinations"><div class="container"><div class="section-head"><div><span class="eyebrow dark">EXPLORE INDIA</span><h2>Popular Destinations</h2></div></div><div class="destination-grid"><a class="destination-card" href="hotels?destination=Goa"><img src="assets/images/destinations/goa.svg"><div><h3>Goa</h3><span>Beaches & resorts</span></div></a><a class="destination-card" href="hotels?destination=Mumbai"><img src="assets/images/destinations/mumbai.svg"><div><h3>Mumbai</h3><span>City escapes</span></div></a><a class="destination-card" href="hotels?destination=Jaipur"><img src="assets/images/destinations/jaipur.svg"><div><h3>Jaipur</h3><span>Royal stays</span></div></a><a class="destination-card" href="hotels?destination=Manali"><img src="assets/images/destinations/manali.svg"><div><h3>Manali</h3><span>Mountain retreats</span></div></a></div></div></section>
<section class="section soft"><div class="container"><div class="section-head"><div><span class="eyebrow dark">HANDPICKED STAYS</span><h2>Featured Hotels</h2></div><a href="hotels?destination=" class="btn btn-outline-dark">View all hotels</a></div><div class="row g-4"><% for(com.hotelbooking.model.Hotel h:(List<com.hotelbooking.model.Hotel>)request.getAttribute("featuredHotels")) { %><div class="col-md-6 col-lg-4"><div class="hotel-card"><div class="hotel-img"><img src="<%=h.getImageUrl()%>" onerror="this.src='assets/images/hotels/fallback.svg'"><span class="price-badge">₹<%=h.getStartingPrice()%> / night</span></div><div class="hotel-body"><div class="stars"><%= "★".repeat((int)Math.round(h.getStarRating())) %></div><h3><%=h.getName()%></h3><p class="muted"><i class="fa-solid fa-location-dot"></i> <%=h.getCity()%>, <%=h.getState()%></p><p><%=h.getDescription()%></p><div class="d-flex justify-content-between align-items-center"><span class="rating"><b><%=h.getGuestRating()%></b> Excellent · <%=h.getReviewCount()%> reviews</span><a class="btn btn-brand" href="hotel?id=<%=h.getId()%>">View Details</a></div></div></div></div><% } %></div></div></section>
<footer><div class="container py-5"><div class="row"><div class="col-lg-5"><h4>Incredible India Hotels</h4><p>Discover comfortable stays, luxury resorts and memorable Indian escapes.</p></div><div class="col"><h6>Quick Links</h6><a href="hotels?destination=">Hotels</a><a href="about.jsp">About</a><a href="contact.jsp">Contact</a></div><div class="col"><h6>Popular Cities</h6><a href="hotels?destination=Mumbai">Mumbai</a><a href="hotels?destination=Goa">Goa</a><a href="hotels?destination=Jaipur">Jaipur</a></div></div></div></footer>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script></body></html>
